{
  "expo": {
    "name": "FleetTool",
    "slug": "fleettool",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fleettool",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.webnstuff.fleettool",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.webnstuff.fleettool",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A3A5C"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/roboto/400Regular/Roboto_400Regular.ttf",
            "./node_modules/@expo-google-fonts/roboto/500Medium/Roboto_500Medium.ttf",
            "./node_modules/@expo-google-fonts/roboto/700Bold/Roboto_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FleetTool använder dina bilder så att du kan lägga till en bild på ett verktyg.",
          "cameraPermission": "FleetTool använder kameran så att du kan fotografera ett verktyg och lägga till bilden.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-localization",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
